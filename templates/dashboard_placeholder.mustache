{{!
    @template local_embeddiscussion/dashboard_placeholder

    What the filter puts in place of the dashboard's token: the skeleton, in a container that the
    dashboard JS module finds by data-region and fills with the live dashboard.

    Classes required for JS:
    * filter-embeddiscussion-dashboard

    Data attributes required for JS:
    * data-region="filter-embeddiscussion-dashboard"
    * data-courseid

    Context variables required for this template:
    * uid (string)
    * courseid (int)

    Example context (json):
    {
        "uid": "embeddisc_dashboard_42",
        "courseid": 42
    }
}}
<div class="filter-embeddiscussion-dashboard" data-region="filter-embeddiscussion-dashboard" id="{{uid}}" data-courseid="{{courseid}}">
  {{> local_embeddiscussion/dashboard_skeleton }}
</div>
